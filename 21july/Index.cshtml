@model _21julyemployee.Models.Employee

<div class="text-center">
    <h1 class="display-4">Employee Registration Form</h1>
    
</div>
<form asp-controller="Home" asp-action="Index" method="Post">
    <div>
        <label asp-for="employee_id"></label>
        <input asp-for="employee_id" class="form-control" />
        <span asp-validation-for="employee_id" style="color:red"></span>
    </div>
    <br />
    <div>
        <label asp-for="employee_name"></label>
        <input asp-for="employee_name" class="form-control" />
    <span asp-validation-for="employee_name" style="color:red"></span>
    </div>
    <br/>
    
    <div>
        <label asp-for="department"></label>
        <input asp-for="department" class="form-control" />
        <span asp-validation-for="department" style="color:red"></span>
    </div>
    <br />
    <div>
        <label asp-for="salary"></label>
        <input asp-for="salary" class="form-control" />
        <span asp-validation-for="salary" style="color:red"></span>
    </div>
    <br />
    <div>
        <label asp-for="email"></label>
        <input asp-for="email" class="form-control" />
        <span asp-validation-for="email" style="color:red"></span>
    </div>
    <br />
    <button type="submit">Register</button>
</form>
